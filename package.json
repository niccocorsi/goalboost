{
  "name": "goalboost-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npx serve -s . -l 5000",
    "dev": "npx serve . -l 5000",
    "electron": "electron .",
    "package:win": "npx electron-packager . GoalBoost --platform=win32 --arch=x64 --out=dist --overwrite",
    "package:mac": "npx electron-packager . GoalBoost --platform=darwin --arch=x64 --out=dist --overwrite",
    "package:linux": "npx electron-packager . GoalBoost --platform=linux --arch=x64 --out=dist --overwrite"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-packager": "^16.0.0",
    "serve": "^14.0.1"
  }
}